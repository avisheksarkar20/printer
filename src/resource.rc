#include <windows.h>
#include "resource.h"

// Embed the side-by-side manifest so Common Controls v6 and DPI awareness
// are active without needing an external .exe.manifest file.
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Main menu
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh\tF5",              IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                      IDM_FILE_EXIT
    END
    POPUP "&Job"
    BEGIN
        MENUITEM "&Pause",                     IDM_JOB_PAUSE
        MENUITEM "&Resume",                    IDM_JOB_RESUME
        MENUITEM "&Cancel\tDel",               IDM_JOB_CANCEL
        MENUITEM "Res&tart",                   IDM_JOB_RESTART
        MENUITEM SEPARATOR
        MENUITEM "Move &Up",                   IDM_JOB_MOVEUP
        MENUITEM "Move &Down",                 IDM_JOB_MOVEDOWN
    END
    POPUP "&Printer"
    BEGIN
        MENUITEM "&Pause printer",             IDM_PRINTER_PAUSE
        MENUITEM "&Resume printer",            IDM_PRINTER_RESUME
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                  IDM_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Context menu for the job list
IDR_JOBMENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Pause",                     IDM_JOB_PAUSE
        MENUITEM "&Resume",                    IDM_JOB_RESUME
        MENUITEM "&Cancel",                    IDM_JOB_CANCEL
        MENUITEM "Res&tart",                   IDM_JOB_RESTART
        MENUITEM SEPARATOR
        MENUITEM "Move &Up",                   IDM_JOB_MOVEUP
        MENUITEM "Move &Down",                 IDM_JOB_MOVEDOWN
    END
END

/////////////////////////////////////////////////////////////////////////////
// Version info
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,0,0,0
    PRODUCTVERSION  1,0,0,0
    FILEFLAGSMASK   0x3fL
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PrintQueueManager"
            VALUE "FileDescription",  "Print Queue Manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PrintQueueManager"
            VALUE "OriginalFilename", "PrintQueueManager.exe"
            VALUE "ProductName",      "Print Queue Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
